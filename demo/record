#!/bin/bash
# demo/record <demo-home> <out-dir>
# Rebuilds the demo home, starts the nested session and plays the storyboard
# while gpu-screen-recorder captures DEMO_MONITOR. Writes <out-dir>/raw.mp4
# and <out-dir>/captions.tsv (seconds from the start, caption) for
# demo/render. Every input goes to the nested session: typing with wtype on
# its display, the pointer through demo/.build/vpointer, actions through its
# own hyprctl. Nothing reaches the real session.

set -euo pipefail

DEMO=${1:?usage: demo/record <demo-home> <out-dir>}
OUT=${2:?usage: demo/record <demo-home> <out-dir>}
HERE=$(cd "$(dirname "$0")" && pwd)
MONITOR=${DEMO_MONITOR:-eDP-1}

mkdir -p "$OUT"
OUT=$(cd "$OUT" && pwd)

# ------------------------------------------------------------------ session

"$HERE/session" "$DEMO" stop 2>/dev/null || true
sleep 1
"$HERE/setup" "$DEMO" >/dev/null
DEMO=$(cd "$DEMO" && pwd)
[[ -x $HERE/.build/vpointer ]] || "$HERE/build-vpointer" >/dev/null
"$HERE/session" "$DEMO" start
STATE=$DEMO/.session

# Runs a command against the nested session, leaving this script's env (and
# so the recorder) on the real one.
# shellcheck disable=SC1090  # the state file demo/session wrote
nested() { (source "$STATE"; "$@"); }
dispatch() { nested hyprctl dispatch "$1" >/dev/null; }
type_text() { nested wtype -d "${2:-45}" "$1"; }
key() { nested wtype -k "$1"; }
launch() { dispatch "hl.dsp.exec_cmd(\"$1\")"; }
focus_ws() { dispatch "hl.dsp.focus({ workspace = \"$1\" })"; }

# One long-lived pointer, so moves are continuous.
mkfifo "$OUT/.pointer"
nested "$HERE/.build/vpointer" <"$OUT/.pointer" &
pointer_pid=$!
exec 7>"$OUT/.pointer"
ptr() { echo "$*" >&7; }
ptr "size 1280 800"
ptr "move 1180 720"

cleanup() {
  exec 7>&- 2>/dev/null || true
  rm -f "$OUT/.pointer"
  kill "$pointer_pid" 2>/dev/null || true
  [[ -n ${recorder_pid:-} ]] && kill -INT "$recorder_pid" 2>/dev/null || true
}
trap cleanup EXIT

# Closes every window in the demo, letting Chrome shut down cleanly so it
# never offers to restore pages.
close_all() {
  local address
  for address in $(nested hyprctl clients -j | jq -r '.[].address'); do
    dispatch "hl.dsp.window.close({ window = \"address:$address\" })"
  done
  sleep 2
}

# ------------------------------------------------------------------- staging

# Chrome's first start of a profile is slow; warm both up off camera.
focus_ws 1
launch "omaprojectspace browser"
sleep 5
focus_ws 2
launch "omaprojectspace browser"
sleep 5
close_all

# Globex already has a terminal open, so the strip has something to reveal.
focus_ws 2
launch "omarchy-launch-terminal"
sleep 2
type_text "clear" 5
key Return
focus_ws 1
sleep 2

# ------------------------------------------------------------------ recording

gpu-screen-recorder -w "$MONITOR" -f 60 -k h264 -q very_high -o "$OUT/raw.mp4" >"$OUT/recorder.log" 2>&1 &
recorder_pid=$!
sleep 1.2
t0=$(date +%s.%N)
: >"$OUT/captions.tsv"
caption() { printf '%s\t%s\n' "$(awk -v a="$(date +%s.%N)" -v b="$t0" 'BEGIN { printf "%.2f", a - b }')" "$1" >>"$OUT/captions.tsv"; }

sleep 1.5

# 1. The bar knows which team each workspace belongs to.
caption "Every workspace can belong to a team"
ptr "glide 45 9 900"; sleep 1.0
sleep 2.6
ptr "glide 640 420 700"; sleep 1.2

# 2. Launch from the app launcher: it starts in the team's folder, with its env.
caption "Anything you launch starts in the team's folder, with the team's env"
nested omarchy-menu toggle apps; sleep 0.9
type_text "foot" 90; sleep 0.6
key Return; sleep 1.6
type_text "omaprojectspace status" 45; sleep 0.3
key Return; sleep 3.2

# 3. The browser keybind opens the team's own Chrome profile.
caption "Even the browser: the team's own Chrome profile"
launch "omaprojectspace browser"; sleep 4.2

# 4. Another workspace, another team.
caption "Switch workspace, switch team"
focus_ws 2; sleep 1.0
type_text "omaprojectspace status" 45; sleep 0.3
key Return; sleep 2.0
launch "omaprojectspace browser"; sleep 4.0

# 5. The panel: attach workspace 3 to Initech and name it, from the keyboard.
caption "Attach and name workspaces from the bar (Super+Alt+P)"
ptr "glide 45 9 800"; sleep 1.1
ptr "glide 153 9 450"; sleep 0.8
ptr "click left"; sleep 1.4
key 3; sleep 0.8
key Right; sleep 0.7
key Right; sleep 0.7
key Right; sleep 1.3
key e; sleep 0.5
type_text "Reports" 110; sleep 0.4
key Return; sleep 1.6
key Escape; sleep 0.6
ptr "glide 900 520 600"; sleep 0.8

# 6. Under the hood: a folder with a mise config.
caption "A projectspace is just a folder with a mise config"
focus_ws 3; sleep 0.9
nested omarchy-menu toggle apps; sleep 0.8
type_text "foot" 90; sleep 0.5
key Return; sleep 1.6
type_text "cat mise.toml" 50; sleep 0.3
key Return; sleep 4.2

caption "No daemon, no registry: one shim in front of uwsm-app"
type_text "omaprojectspace list" 45; sleep 0.3
key Return; sleep 3.6

kill -INT "$recorder_pid"
wait "$recorder_pid" 2>/dev/null || true
recorder_pid=""
echo "recorded $OUT/raw.mp4"
cat "$OUT/captions.tsv"

#!/bin/bash

# omaprojectspace — attach Hyprland workspaces to projectspaces.
#
# A projectspace is a folder (by default one level under ~/Projects) with a
# mise config at its root. Its mise env — browser, Claude config dir, herdr
# session, tools — is what everything launched on an attached workspace gets.
# The filesystem defines projectspaces; the only state kept here is which
# workspace is attached to which folder.

set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
REPO=$(dirname "$(dirname "$SELF")")

CONFIG_DIR=${OMAPROJECTSPACE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omaprojectspace}
ATTACHMENTS=$CONFIG_DIR/attachments.json
ROOTS=${OMAPROJECTSPACE_ROOTS:-$HOME/Projects}
REAL_UWSM_APP=${OMAPROJECTSPACE_REAL_UWSM_APP:-/usr/bin/uwsm-app}
MISE=${OMAPROJECTSPACE_MISE:-mise}
STATE_DIR=${OMAPROJECTSPACE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omaprojectspace}

# Session plumbing started through uwsm-app at login. Workspace 1 is active
# then and may well be attached; none of these should carry a team's env.
PASSTHROUGH="hyprsunset udiskie omarchy-hyprland-monitor-watch quickshell omarchy-launch-shell uwsm ${OMAPROJECTSPACE_PASSTHROUGH:-}"

# Env keys that describe the projectspace itself rather than configure tools.
# They never show up as "what this projectspace sets".
META_KEYS='["PROJECTSPACE","PROJECTSPACE_HOME","PROJECTSPACE_COLOR","PROJECTSPACE_ICON","PATH","MANPATH"]'

die() { echo "omaprojectspace: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: omaprojectspace <command> [args]

Projectspaces
  list [--json]                   Projectspaces found under the roots, with attachments
  status [--ws N] [--json]        The workspace's projectspace (default: the active one)
  env [--ws N | --name P] [--json]
                                  The env a launch there gets
  exec [--ws N | --name P] -- CMD Run CMD with that env, from the projectspace home

Attachments
  attach <ws> <name|path>         Attach workspace <ws> (1-10) to a projectspace
  detach <ws>                     Detach workspace <ws>

Windows
  save [--auto]                   Snapshot the windows on workspaces 1-10 (runs every
                                  minute from Hyprland)
  windows [--json]                The last session's windows, and which are not open now
  restore [--ws N] [--dry-run]    Reopen the last session's windows that are not open
                                  now, each on its own workspace (default: all)

Session
  launch -- <uwsm-app args>       Used by the uwsm-app shim: launch with the active
                                  workspace's projectspace env
  browser [url...]                Open the projectspace's $BROWSER, else the default browser
  install | uninstall             Link the plugin, CLI, shim and Hyprland binds into place
  doctor                          Check the installation and every projectspace

Environment
  OMAPROJECTSPACE_ROOTS           Colon-separated folders to scan (default ~/Projects)
  OMAPROJECTSPACE=off             Make the shim a plain uwsm-app
  OMAPROJECTSPACE_WORKSPACE=N     Treat N as the active workspace
  OMAPROJECTSPACE_PASSTHROUGH     Extra commands the shim never touches
EOF
}

# ---------------------------------------------------------------- helpers

has_mise_config() {
  local dir=$1 f
  for f in mise.toml mise.local.toml .mise.toml .mise.local.toml .config/mise.toml .config/mise/config.toml mise/config.toml; do
    [[ -f $dir/$f ]] && { echo "$dir/$f"; return 0; }
  done
  return 1
}

# ~/x → /home/me/x, and the reverse for storage, so the file survives a
# different home directory.
# shellcheck disable=SC2088  # a literal ~ is exactly what is being matched
expand_home() { local p=$1; [[ $p == "~" || $p == "~/"* ]] && p=$HOME${p:1}; echo "$p"; }
contract_home() { local p=$1; [[ $p == "$HOME" || $p == "$HOME/"* ]] && p="~${p#"$HOME"}"; echo "$p"; }

valid_ws() { [[ $1 =~ ^([1-9]|10)$ ]]; }

active_workspace() {
  if [[ -n ${OMAPROJECTSPACE_WORKSPACE:-} ]]; then
    echo "$OMAPROJECTSPACE_WORKSPACE"
    return
  fi
  hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty'
}

attachments_json() {
  if [[ -s $ATTACHMENTS ]]; then
    jq -c '.workspaces // {}' "$ATTACHMENTS" 2>/dev/null || echo '{}'
  else
    echo '{}'
  fi
}

# Attachments with ~ expanded, so homes compare as plain strings.
attachments_expanded() {
  attachments_json | jq -c --arg h "$HOME" 'map_values(if startswith("~") then $h + .[1:] else . end)'
}

# The home attached to a workspace, expanded, or nothing.
attached_home() {
  local ws=$1 home
  home=$(attachments_json | jq -r --arg ws "$ws" '.[$ws] // empty')
  [[ -n $home ]] && expand_home "$home"
  return 0
}

# Written under a lock and swapped in whole: the bar widget and a terminal can
# both be attaching at once.
write_attachments() {
  local filter=$1; shift
  mkdir -p "$CONFIG_DIR"
  (
    flock 9
    local current tmp
    current=$(attachments_json)
    tmp=$(mktemp "$ATTACHMENTS.XXXXXX")
    jq -n --argjson ws "$current" "$@" "{version: 1, workspaces: (\$ws | $filter)}" >"$tmp"
    mv "$tmp" "$ATTACHMENTS"
  ) 9>"$CONFIG_DIR/.lock"
  # Live bars pick the change up through their file watch too; this is the
  # fast path.
  omarchy-shell -q mehiel.omaprojectspace refresh >/dev/null 2>&1 || true
}

# Every projectspace home under the roots, one per line.
discover() {
  local root dir
  IFS=: read -ra roots <<<"$ROOTS"
  for root in "${roots[@]}"; do
    root=$(expand_home "$root")
    [[ -d $root ]] || continue
    for dir in "$root"/*/; do
      dir=${dir%/}
      has_mise_config "$dir" >/dev/null && echo "$dir"
    done
  done
  # Attached folders count even when they sit outside every root.
  attachments_json | jq -r '.[]' | while read -r home; do
    home=$(expand_home "$home")
    [[ -d $home ]] && echo "$home"
  done
  return 0
}

# A name or a path → a projectspace home.
resolve() {
  local want=$1 home
  if [[ $want == */* || $want == "~"* || $want == . ]]; then
    home=$(readlink -f "$(expand_home "$want")" 2>/dev/null) || die "no such folder: $want"
    [[ -d $home ]] || die "no such folder: $want"
    has_mise_config "$home" >/dev/null || die "$home has no mise config, so it is not a projectspace"
    echo "$home"
    return
  fi
  while read -r home; do
    if [[ $(basename "$home") == "$want" ]]; then echo "$home"; return; fi
  done < <(discover | sort -u)
  die "no projectspace named '$want' (see: omaprojectspace list)"
}

# The full env mise gives a launch from <home>, as JSON. On failure prints
# mise's first error line to stderr and returns 1.
mise_env_json() {
  local home=$1 out err
  err=$(mktemp)
  if out=$(cd "$home" && "$MISE" env --json 2>"$err"); then
    rm -f "$err"
    echo "$out"
  else
    # mise leads with "error parsing config file"; the line that says why
    # (an untrusted config, a TOML error) is the useful one.
    local lines
    lines=$(sed 's/\x1b\[[0-9;]*m//g; s/^mise ERROR //' "$err" | grep -v '^\s*$' | grep -vE '^(Version:|Run with|error parsing config file)' || true)
    { grep -m1 -i 'not trusted' <<<"$lines" || head -1 <<<"$lines"; } >&2
    rm -f "$err"
    return 1
  fi
}

# Everything a launch sees: mise's env, then our own markers.
projectspace_env_json() {
  local home=$1 env
  env=$(mise_env_json "$home") || return 1
  jq -c --arg home "$home" --arg name "$(basename "$home")" \
    '. + {PROJECTSPACE: (.PROJECTSPACE // $name), PROJECTSPACE_HOME: $home}' <<<"$env"
}

# One projectspace as JSON for list/status: identity, attachments, look, and
# the env it sets on top of what $HOME already gets.
describe() {
  local home=$1 base_env=$2 attachments=$3 env error="" config
  config=$(has_mise_config "$home" || true)
  if ! env=$(projectspace_env_json "$home" 2>"$CONFIG_DIR/.err.$$"); then
    error=$(cat "$CONFIG_DIR/.err.$$")
    env='{}'
  fi
  rm -f "$CONFIG_DIR/.err.$$"
  jq -nc \
    --arg home "$home" --arg config "$config" --arg error "$error" \
    --argjson env "$env" --argjson base "$base_env" --argjson att "$attachments" \
    --argjson meta "$META_KEYS" --arg tilde "$(contract_home "$home")" '
    {
      name: ($env.PROJECTSPACE // ($home | split("/") | last)),
      folder: ($home | split("/") | last),
      home: $home,
      display: $tilde,
      config: $config,
      ok: ($error == ""),
      error: $error,
      color: ($env.PROJECTSPACE_COLOR // ""),
      icon: ($env.PROJECTSPACE_ICON // ""),
      browser: ($env.BROWSER // ""),
      workspaces: [ $att | to_entries[] | select(.value == $home) | .key | tonumber ] | sort,
      env: ($env | with_entries(select(
        (.key as $k | $meta | index($k) | not) and ($base[.key] != .value)
      )) | to_entries | sort_by(.key) | from_entries)
    }'
}

list_json() {
  mkdir -p "$CONFIG_DIR"
  local attachments base home
  attachments=$(attachments_expanded)
  base=$(mise_env_json "$HOME" 2>/dev/null || echo '{}')
  {
    while read -r home; do
      describe "$home" "$base" "$attachments"
    done < <(discover | sort -u)
  } | jq -sc --argjson att "$attachments" '
    sort_by(.name | ascii_downcase) as $ps
    | {
        projectspaces: $ps,
        attachments: ($att | with_entries(.value as $h | .value = {
          home: $h,
          name: ([$ps[] | select(.home == $h) | .name][0] // null),
          missing: ([$ps[] | select(.home == $h)] | length == 0)
        }))
      }'
}

# ------------------------------------------------------------- commands

cmd_list() {
  local json=false
  [[ ${1:-} == --json ]] && json=true
  local data
  data=$(list_json)
  if $json; then echo "$data"; return; fi
  jq -r '
    .projectspaces[] |
    "\(.name)\t\(.display)\t\(if (.workspaces|length) > 0 then "ws " + (.workspaces | map(tostring) | join(",")) else "-" end)\t\(if .ok then "" else "! " + .error end)"
  ' <<<"$data" | column -t -s $'\t'
}

parse_target() {
  # Sets TARGET_WS / TARGET_HOME from --ws N / --name P, defaulting to the
  # active workspace. Leaves the remaining args in REST.
  TARGET_WS="" TARGET_HOME="" REST=()
  while (($#)); do
    case $1 in
    --ws) TARGET_WS=$2; shift 2 ;;
    --ws=*) TARGET_WS=${1#--ws=}; shift ;;
    --name) TARGET_HOME=$(resolve "$2"); shift 2 ;;
    --name=*) TARGET_HOME=$(resolve "${1#--name=}"); shift ;;
    *) REST+=("$1"); shift ;;
    esac
  done
  if [[ -z $TARGET_HOME ]]; then
    [[ -n $TARGET_WS ]] || TARGET_WS=$(active_workspace)
    [[ -n $TARGET_WS ]] && TARGET_HOME=$(attached_home "$TARGET_WS")
  fi
  return 0
}

cmd_status() {
  parse_target "$@"
  local json=false
  [[ ${REST[0]:-} == --json ]] && json=true
  if [[ -z $TARGET_HOME ]]; then
    if $json; then jq -nc --arg ws "$TARGET_WS" '{workspace: ($ws | tonumber? // null), projectspace: null}'
    else echo "workspace ${TARGET_WS:-?}: no projectspace"; fi
    return
  fi
  local base desc
  base=$(mise_env_json "$HOME" 2>/dev/null || echo '{}')
  desc=$(describe "$TARGET_HOME" "$base" "$(attachments_expanded)")
  if $json; then
    jq -c --arg ws "$TARGET_WS" '{workspace: ($ws | tonumber? // null), projectspace: .}' <<<"$desc"
  else
    # Paths read as ~/..., like everywhere else the CLI prints them.
    jq -r --arg ws "${TARGET_WS:-?}" --arg home "$HOME" '
      def tilde: if startswith($home + "/") or . == $home then "~" + .[($home | length):] else . end;
      "workspace \($ws): \(.name)  \(.display)",
      (if .ok then empty else "  ! " + .error end),
      (.env | to_entries[] | "  \(.key)=\(.value | tilde)")
    ' <<<"$desc"
  fi
}

cmd_env() {
  parse_target "$@"
  [[ -n $TARGET_HOME ]] || die "workspace ${TARGET_WS:-?} has no projectspace"
  local env
  env=$(projectspace_env_json "$TARGET_HOME") || die "mise could not load $TARGET_HOME"
  if [[ ${REST[0]:-} == --json ]]; then echo "$env"
  else jq -r 'to_entries[] | "\(.key)=\(.value)"' <<<"$env"; fi
}

# Exports an env (as JSON) into this process.
export_env_json() {
  local pair
  while IFS= read -r -d '' pair; do
    export "${pair?}"
  done < <(jq -j 'to_entries[] | select(.key | test("^[A-Za-z_][A-Za-z0-9_]*$")) | "\(.key)=\(.value)\u0000"' <<<"$1")
}

# Exports a projectspace env into this process and moves into its home.
apply_env() {
  local home=$1 env
  env=$(projectspace_env_json "$home") || return 1
  export_env_json "$env"
  cd "$home"
}

cmd_exec() {
  parse_target "$@"
  set -- "${REST[@]}"
  [[ ${1:-} == -- ]] && shift
  (($#)) || die "exec needs a command: omaprojectspace exec [--ws N] -- cmd"
  if [[ -n $TARGET_HOME ]]; then
    apply_env "$TARGET_HOME" || die "mise could not load $TARGET_HOME"
  fi
  exec "$@"
}

# shellcheck disable=SC2016  # jq filters, expanded by jq
cmd_attach() {
  (($# == 2)) || die "usage: omaprojectspace attach <ws> <name|path>"
  valid_ws "$1" || die "workspace must be 1-10, got '$1'"
  local home
  home=$(resolve "$2")
  write_attachments '.[$k] = $v' --arg k "$1" --arg v "$(contract_home "$home")"
  echo "workspace $1 → $(basename "$home") ($(contract_home "$home"))"
}

# shellcheck disable=SC2016
cmd_detach() {
  (($# == 1)) || die "usage: omaprojectspace detach <ws>"
  valid_ws "$1" || die "workspace must be 1-10, got '$1'"
  write_attachments 'del(.[$k])' --arg k "$1"
  echo "workspace $1 detached"
}

notify() {
  command -v notify-send >/dev/null && notify-send -a Projectspaces -u normal "$@" >/dev/null 2>&1 || true
}

# The uwsm-app shim lands here. Whatever happens, the app launches: any
# failure to load the projectspace falls back to a plain uwsm-app.
cmd_launch() {
  [[ ${1:-} == -- ]] && shift
  local args=("$@")

  # Anything below that fails under set -e exits through here, so the app
  # still starts, plainly. A successful exec replaces the process and this
  # never runs.
  LAUNCH_ARGS=("$@")
  trap 'trap - EXIT; exec "$REAL_UWSM_APP" "${LAUNCH_ARGS[@]}"' EXIT

  [[ ${OMAPROJECTSPACE:-} == off ]] && exec "$REAL_UWSM_APP" "${args[@]}"

  # Find the command after uwsm-app's own options. No command (stop, ping,
  # help) means this is not an app launch.
  local i=0 cmd=""
  while ((i < ${#args[@]})); do
    case ${args[i]} in
    --) cmd=${args[i + 1]:-}; break ;;
    -[stauSdp]) i=$((i + 2)) ;;
    -T | -h | --help) i=$((i + 1)) ;;
    -*) i=$((i + 1)) ;;
    *) cmd=${args[i]}; break ;;
    esac
  done
  [[ -n $cmd && $cmd != stop && $cmd != ping ]] || exec "$REAL_UWSM_APP" "${args[@]}"

  local name=${cmd##*/}
  local skip
  for skip in $PASSTHROUGH; do
    [[ $name == "$skip" ]] && exec "$REAL_UWSM_APP" "${args[@]}"
  done

  local ws home
  ws=$(active_workspace || true)
  # The app itself must not keep it: whatever it launches later belongs to
  # whichever workspace is active then.
  unset OMAPROJECTSPACE_WORKSPACE
  home=""
  [[ -n $ws ]] && home=$(attached_home "$ws")

  # A launch from an unattached workspace never inherits a projectspace the
  # caller happened to carry.
  if [[ -z $home ]]; then
    exec env -u PROJECTSPACE -u PROJECTSPACE_HOME "$REAL_UWSM_APP" "${args[@]}"
  fi

  if [[ ! -d $home ]]; then
    notify "Projectspace missing" "Workspace $ws is attached to $(contract_home "$home"), which no longer exists."
    exec "$REAL_UWSM_APP" "${args[@]}"
  fi

  local env err
  err=$(mktemp)
  if ! env=$(projectspace_env_json "$home" 2>"$err"); then
    notify "Projectspace env not loaded" "$(basename "$home"): $(cat "$err"). Launched without it."
    rm -f "$err"
    exec "$REAL_UWSM_APP" "${args[@]}"
  fi
  rm -f "$err"
  export_env_json "$env"
  cd "$home"

  # Terminals: omarchy-launch-terminal passes the focused terminal's cwd, or
  # $HOME when there is none. Only that fallback moves to the projectspace.
  for i in "${!args[@]}"; do
    if [[ ${args[i]} == "--dir=$HOME" || ${args[i]} == "--dir=$HOME/" ]]; then
      args[i]="--dir=$home"
    elif [[ ${args[i]} == --dir && ${args[i + 1]:-} == "$HOME" ]]; then
      args[i + 1]=$home
    fi
  done

  exec "$REAL_UWSM_APP" "${args[@]}"
}

# The projectspace's own browser when it sets one, the desktop default
# otherwise. For keybinds: omarchy-launch-browser hands URLs to an already
# running Chrome directly, so it never reaches the shim.
cmd_browser() {
  local ws home browser=""
  ws=$(active_workspace || true)
  unset OMAPROJECTSPACE_WORKSPACE
  home=""
  [[ -n $ws ]] && home=$(attached_home "$ws")
  if [[ -n $home && -d $home ]]; then
    browser=$(projectspace_env_json "$home" 2>/dev/null | jq -r '.BROWSER // empty') || browser=""
  fi
  if [[ -z $browser ]]; then
    exec omarchy-launch-browser "$@"
  fi
  exec "$REAL_UWSM_APP" -- "$SELF" exec --ws "$ws" -- "$browser" "$@"
}

# ------------------------------------------------------------- windows
#
# A snapshot records, per workspace, what it takes to open each window again:
# a terminal's folder and the session it ran (herdr, tmux, zellij), the
# browser, or an app's desktop entry. Hyprland runs `save --auto` every
# minute into session.json. The first save of a new Hyprland instance moves
# the old file to last-session.json, which is what `restore` reads.

SESSION_FILE=$STATE_DIR/session.json
LAST_FILE=$STATE_DIR/last-session.json
TERMINALS=" foot Alacritty kitty com.mitchellh.ghostty org.wezfurlong.wezterm "
RESUMABLE=" herdr tmux zellij "
BROWSER_CLASSES='^(google-chrome(-beta|-unstable)?|[Cc]hromium|brave-browser|microsoft-edge|vivaldi-stable|helium|firefox|zen)$'
RESTORE_TIMEOUT=${OMAPROJECTSPACE_RESTORE_TIMEOUT:-15}

# The Hyprland instance a snapshot belongs to.
instance_id() { echo "${OMAPROJECTSPACE_INSTANCE:-${HYPRLAND_INSTANCE_SIGNATURE:-}}"; }

# id<TAB>StartupWMClass<TAB>Name<TAB>Exec for every visible desktop entry,
# user entries first so they shadow system ones with the same id.
desktop_index() {
  local dirs=${OMAPROJECTSPACE_APPLICATIONS:-${XDG_DATA_HOME:-$HOME/.local/share}/applications:$HOME/.local/share/flatpak/exports/share/applications:/var/lib/flatpak/exports/share/applications:/usr/local/share/applications:/usr/share/applications}
  local dir files=()
  IFS=: read -ra dirs <<<"$dirs"
  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] && files+=("$dir"/*.desktop)
  done
  ((${#files[@]})) || return 0
  awk -F= '
    FNR == 1 { if (id != "" && !hidden) print id "\t" wm "\t" name "\t" exec; n = split(FILENAME, parts, "/"); id = parts[n]; wm = ""; name = ""; exec = ""; hidden = 0; main = 0 }
    /^\[/ { main = ($0 == "[Desktop Entry]") }
    main && $1 == "StartupWMClass" { wm = substr($0, index($0, "=") + 1) }
    main && $1 == "Name" && name == "" { name = substr($0, index($0, "=") + 1) }
    main && $1 == "Exec" && exec == "" { exec = substr($0, index($0, "=") + 1) }
    main && ($1 == "NoDisplay" || $1 == "Hidden") && $2 == "true" { hidden = 1 }
    END { if (id != "" && !hidden) print id "\t" wm "\t" name "\t" exec }
  ' "${files[@]}" 2>/dev/null | awk -F'\t' '!seen[$1]++'
}

# The desktop entry that opens windows of <class>: its StartupWMClass, else
# an entry named after the class. Prints id<TAB>name.
#
# A Chrome web app's class is chrome-<url>-<profile dir>, but Omarchy writes
# every web app's StartupWMClass with -Default. So a web app matches on the
# URL part, and among entries for the same URL the one whose Exec opens that
# profile wins.
desktop_for_class() {
  local class=$1 index=$2
  awk -F'\t' -v c="${class,,}" '
    function base(s) { sub(/-[^-]*$/, "", s); return s }
    BEGIN {
      webapp = (c ~ /^(chrome|brave|msedge|vivaldi|helium)-.*-[^-]+$/)
      profile = c; sub(/^.*-/, "", profile); gsub(/_/, " ", profile)
    }
    tolower($2) == c { print $1 "\t" $3; exact = 1; exit }
    webapp && $2 != "" && base(tolower($2)) == base(c) {
      e = tolower($4)
      named = (index(e, "--profile-directory=\"" profile "\"") || index(e, "--profile-directory=" profile " ") || e ~ ("--profile-directory=" profile "$"))
      if (named && sameprofile == "") sameprofile = $1 "\t" $3
      else if (profile == "default" && e !~ /--profile-directory/ && sameprofile == "") sameprofile = $1 "\t" $3
      else if (anyprofile == "") anyprofile = $1 "\t" $3
    }
    tolower($1) == c ".desktop" && byid == "" { byid = $1 "\t" $3 }
    END {
      if (exact) exit
      if (sameprofile != "") print sameprofile
      else if (byid != "") print byid
      else if (anyprofile != "") print anyprofile
    }
  ' <<<"$index"
}

# A terminal's folder: Omarchy's own answer (its shell's cwd, or kitty's),
# else the cwd of whatever the terminal runs directly, as with `foot -e tmux`.
terminal_dir() {
  local pid=$1 dir child="" f children c
  dir=$(omarchy-cmd-terminal-cwd "$pid" 2>/dev/null || true)
  if [[ -z $dir || $dir == "$HOME" ]]; then
    for f in /proc/"$pid"/task/*/children; do
      [[ -r $f ]] || continue
      read -ra children <"$f" || true
      for c in "${children[@]}"; do ((c > ${child:-0})) && child=$c; done
    done
    [[ -n $child ]] && dir=$(readlink -f "/proc/$child/cwd" 2>/dev/null || true)
  fi
  echo "${dir:-$HOME}"
}

# The session a terminal runs: argv of a resumable program that is the
# terminal's own child or its shell's, as a JSON array. Matched on argv[0],
# not the process name: tmux renames its client "tmux: client".
terminal_command() {
  local pid=$1 child grandchild f children grandchildren
  for f in /proc/"$pid"/task/*/children; do
    [[ -r $f ]] || continue
    read -ra children <"$f" || true
    for child in "${children[@]}"; do
      resumable_argv "$child" && return
      read -ra grandchildren < <(cat /proc/"$child"/task/*/children 2>/dev/null) || true
      for grandchild in "${grandchildren[@]}"; do
        resumable_argv "$grandchild" && return
      done
    done
  done
  echo '[]'
}

resumable_argv() {
  local argv
  argv=$(jq -Rsc 'split("\u0000") | map(select(. != ""))' <"/proc/$1/cmdline" 2>/dev/null) || return 1
  [[ $RESUMABLE == *" $(jq -r '.[0] // "" | split("/") | last' <<<"$argv") "* ]] || return 1
  echo "$argv"
}

# The windows open now on workspaces 1-10, as restorable entries:
# {ws, address, kind, class, dir?, command?, desktop?, name}. Windows nothing
# can reopen come out as kind "unknown".
live_windows() {
  local clients index="" index_built=false ws address class pid dir cmd desktop
  clients=$(hyprctl clients -j 2>/dev/null) || clients='[]'
  while IFS=$'\x1f' read -r ws address class pid; do
    [[ -n $class ]] || continue
    if [[ $TERMINALS == *" $class "* ]]; then
      dir=$(terminal_dir "$pid")
      cmd=$(terminal_command "$pid")
      jq -nc --argjson ws "$ws" --arg a "$address" --arg c "$class" --arg d "$(contract_home "$dir")" --argjson cmd "$cmd" \
        '{ws: $ws, address: $a, kind: "terminal", class: $c, dir: $d, command: $cmd,
          name: (if ($cmd | length) > 0 then ($cmd[0] | split("/") | last) + " · " + $d else "Terminal · " + $d end)}'
    elif [[ $class =~ $BROWSER_CLASSES ]]; then
      jq -nc --argjson ws "$ws" --arg a "$address" --arg c "$class" '{ws: $ws, address: $a, kind: "browser", class: $c, name: "Browser"}'
    else
      $index_built || { index=$(desktop_index); index_built=true; }
      desktop=$(desktop_for_class "$class" "$index")
      if [[ -n $desktop ]]; then
        jq -nc --argjson ws "$ws" --arg a "$address" --arg c "$class" --arg id "${desktop%%$'\t'*}" --arg n "${desktop#*$'\t'}" \
          '{ws: $ws, address: $a, kind: "app", class: $c, desktop: $id, name: (if $n == "" then $id else $n end)}'
      else
        jq -nc --argjson ws "$ws" --arg a "$address" --arg c "$class" '{ws: $ws, address: $a, kind: "unknown", class: $c, name: $c}'
      fi
    fi
  done < <(jq -r '.[] | select(.workspace.id >= 1 and .workspace.id <= 10 and .mapped != false)
    | [.workspace.id, .address, (.initialClass // .class), .pid] | map(tostring) | join("\u001f")' <<<"$clients")
}

# Live windows → a snapshot: grouped by workspace, one browser per
# workspace, one window per app, every terminal.
snapshot_json() {
  local live=$1
  jq -sc --arg inst "$(instance_id)" --argjson now "$(date +%s)" --argjson att "$(attachments_json)" '
    map(select(.kind != "unknown")) as $known
    | {
        version: 1, instance: $inst, saved: $now,
        workspaces: ($known | group_by(.ws) | map({
          key: (.[0].ws | tostring),
          value: {
            projectspace: ($att[.[0].ws | tostring] // null),
            windows: (reduce .[] as $w ([];
              if $w.kind == "terminal" then . + [$w]
              elif any(.[]; .kind == $w.kind and .class == $w.class) then .
              else . + [$w] end) | map(del(.ws, .address)))
          }
        }) | from_entries)
      }' <<<"$live"
}

windows_count() { jq '[.workspaces[]?.windows[]?] | length' "$1" 2>/dev/null || echo 0; }

cmd_save() {
  local auto=false inst live snap
  [[ ${1:-} == --auto ]] && auto=true
  inst=$(instance_id)
  [[ -n $inst ]] || die "not in a Hyprland session"
  mkdir -p "$STATE_DIR"
  live=$(live_windows)
  snap=$(snapshot_json "$live")
  (
    flock 9
    local prev_inst="" count
    [[ -s $SESSION_FILE ]] && prev_inst=$(jq -r '.instance // ""' "$SESSION_FILE" 2>/dev/null || true)
    if [[ -n $prev_inst && $prev_inst != "$inst" ]]; then
      # A new session: what the last one had open becomes restorable. An
      # empty snapshot (a session that ended before saving anything) never
      # replaces a real one.
      if (($(windows_count "$SESSION_FILE") > 0)); then mv "$SESSION_FILE" "$LAST_FILE"; else rm -f "$SESSION_FILE"; fi
      prev_inst=""
    fi
    count=$(jq '[.workspaces[].windows[]] | length' <<<"$snap")
    # Logging out closes every window before Hyprland exits. An automatic
    # save that sees none keeps the snapshot from before.
    if $auto && ((count == 0)) && [[ -n $prev_inst ]] && (($(windows_count "$SESSION_FILE") > 0)); then
      exit 0
    fi
    local tmp
    tmp=$(mktemp "$SESSION_FILE.XXXXXX")
    echo "$snap" >"$tmp"
    mv "$tmp" "$SESSION_FILE"
  ) 9>"$STATE_DIR/.lock"
  $auto && return 0
  jq -r '"Saved \([.workspaces[].windows[]] | length) windows" + (if (.workspaces | length) > 0 then " on workspace" + (if (.workspaces | length) > 1 then "s " else " " end) + (.workspaces | keys_unsorted | map(tonumber) | sort | map(tostring) | join(", ")) else "" end) + "."' <<<"$snap"
  jq -r 'select(.kind == "unknown") | "  can'"'"'t reopen \(.class) on workspace \(.ws): no desktop entry"' <<<"$live" | sort -u
}

# The last session's windows, each marked with whether it is open now. A
# terminal counts as open when one with the same folder and session is; the
# browser when any browser window is on that workspace; an app when its
# window is anywhere (elsewhere gives `elsewhere: <ws>`).
restore_plan() {
  local live=$1
  jq -c --argjson live "$(jq -sc . <<<"$live")" '
    .workspaces // {} | to_entries | map(
      (.key | tonumber) as $ws
      | ($live | map(select(.ws == $ws))) as $here
      | .value + {ws: $ws, windows: (
          reduce .value.windows[] as $w ({out: [], used: []};
            if $w.kind == "terminal" then
              # A session (herdr, tmux) is the terminal; a plain shell is its folder.
              ([$here | to_entries[] | select(.value.kind == "terminal" and .value.command == $w.command
                  and (($w.command | length) > 0 or .value.dir == $w.dir)) | .key] - .used) as $free
              | if ($free | length) > 0 then .used += [$free[0]] | .out += [$w + {open: true}]
                else .out += [$w + {open: false}] end
            elif $w.kind == "browser" then
              .out += [$w + {open: any($here[]; .kind == "browser")}]
            else
              ([$live[] | select(.class == $w.class) | .ws] | unique) as $at
              | if ($at | index($ws)) != null then .out += [$w + {open: true}]
                elif ($at | length) > 0 then .out += [$w + {open: true, elsewhere: $at[0]}]
                else .out += [$w + {open: false}] end
            end) | .out)}
      | . + {missing: ([.windows[] | select(.open | not)] | length)}
    ) | sort_by(.ws)' "$LAST_FILE"
}

# This session's snapshot, so the panel can show that auto-save is running:
# {saved, windows, workspaces}, or null before the first save.
current_json() {
  jq -c --arg i "$(instance_id)" 'select(.instance == $i)
    | {saved, windows: ([.workspaces[].windows[]] | length), workspaces: (.workspaces | length)}' "$SESSION_FILE" 2>/dev/null | grep . || echo null
}

cmd_windows() {
  local json=false plan live current uptime
  [[ ${1:-} == --json ]] && json=true
  current=$(current_json)
  uptime=$(session_age 2>/dev/null || true)
  if [[ ! -s $LAST_FILE ]]; then
    if $json; then
      jq -nc --argjson c "$current" --argjson u "${uptime:-null}" '{saved: null, workspaces: [], current: $c, uptime: $u}'
    else
      echo "No previous session saved yet. Windows are saved every minute; after the next login they can be restored."
    fi
    return
  fi
  live=$(live_windows)
  plan=$(restore_plan "$live")
  if $json; then
    jq -c --argjson plan "$plan" --argjson c "$current" --argjson u "${uptime:-null}" \
      '{saved: .saved, workspaces: $plan, current: $c, uptime: $u}' "$LAST_FILE"
    return
  fi
  echo "Last session, saved $(date -d "@$(jq -r .saved "$LAST_FILE")" '+%a %d %b %H:%M'):"
  jq -r '.[] | "workspace \(.ws)" + (if .projectspace then "  \(.projectspace)" else "" end),
    (.windows[] | "  " + (if .open then (if .elsewhere then "· open on \(.elsewhere)  " else "· open  " end) else "○ " end) + .name)' <<<"$plan"
}

# Seconds since this Hyprland started.
session_age() {
  local pid
  pid=$(hyprctl instances -j 2>/dev/null | jq -r --arg s "${HYPRLAND_INSTANCE_SIGNATURE:-}" '.[] | select(.instance == $s) | .pid' | head -1)
  [[ -n $pid ]] && ps -o etimes= -p "$pid" | tr -d ' '
}

lua_string() { printf '[==[%s]==]' "$1"; }

# Open one window on <ws> without taking focus: a window rule sends the next
# window of <class> there, silently, until it appears or time runs out.
# Launched through Hyprland, so the app gets the session env and the shim
# adds the workspace's projectspace, as if launched from there.
open_on_workspace() {
  local ws=$1 class=$2 command=$3 before re deadline found=""
  before=$(hyprctl clients -j | jq -c '[.[].address]')
  # shellcheck disable=SC2001  # one sed beats a dozen parameter expansions
  re="^($(sed 's/[][\.^$*+?(){}|]/\\&/g' <<<"$class"))\$"
  hyprctl eval "local t = _G.omaprojectspace or {}; _G.omaprojectspace = t; if t.rule then t.rule:set_enabled(false) end; t.rule = hl.window_rule({ match = { class = $(lua_string "$re") }, workspace = '$ws silent', no_initial_focus = true })" >/dev/null || return 1
  hyprctl dispatch "hl.dsp.exec_cmd($(lua_string "OMAPROJECTSPACE_WORKSPACE=$ws $command"))" >/dev/null
  deadline=$((SECONDS + RESTORE_TIMEOUT))
  while ((SECONDS < deadline)); do
    found=$(hyprctl clients -j | jq -r --argjson before "$before" --arg c "$class" \
      '[.[] | select((.initialClass == $c or .class == $c) and (.address as $a | $before | index($a) | not))][0].address // empty')
    [[ -n $found ]] && break
    sleep 0.2
  done
  hyprctl eval "local t = _G.omaprojectspace; if t and t.rule then t.rule:set_enabled(false); t.rule = nil end" >/dev/null || true
  [[ -n $found ]]
}

restore_command() {
  local w=$1 kind dir
  kind=$(jq -r .kind <<<"$w")
  case $kind in
  terminal)
    dir=$(expand_home "$(jq -r .dir <<<"$w")")
    [[ -d $dir ]] || dir=$HOME
    printf '%q -- xdg-terminal-exec %q' "$REPO/shim/uwsm-app" "--dir=$dir"
    jq -r '.command[]' <<<"$w" | while IFS= read -r arg; do printf ' %q' "$arg"; done
    ;;
  browser) printf '%q browser' "$SELF" ;;
  app) printf '%q -- gtk-launch %q' "$REPO/shim/uwsm-app" "$(jq -r .desktop <<<"$w")" ;;
  esac
}

cmd_restore() {
  local only="" dry=false login=false notify_done=false
  while (($#)); do
    case $1 in
    --ws) only=${2:-}; shift 2 ;;
    --dry-run) dry=true; shift ;;
    --login) login=true; notify_done=true; shift ;;
    --notify) notify_done=true; shift ;;
    *) die "restore: unknown option $1" ;;
    esac
  done
  [[ -z $only ]] || valid_ws "$only" || die "workspace must be 1-10, not '$only'"
  if [[ ! -s $LAST_FILE ]]; then
    $login && return 0
    echo "Nothing to restore: no previous session saved yet."
    return 0
  fi
  mkdir -p "$STATE_DIR"
  exec 8>"$STATE_DIR/.restore.lock"
  flock -n 8 || die "a restore is already running"

  if $login; then
    # Once per session, and only right after login: turning the setting on,
    # or restarting the shell, later in the day reopens nothing.
    local inst age
    inst=$(instance_id)
    [[ $(jq -r '.restored_instance // ""' "$LAST_FILE") == "$inst" ]] && return 0
    age=$(session_age || true)
    [[ -n $age ]] && ((age < ${OMAPROJECTSPACE_LOGIN_WINDOW:-300})) || return 0
    local tmp
    tmp=$(mktemp "$LAST_FILE.XXXXXX")
    jq --arg i "$inst" '.restored_instance = $i' "$LAST_FILE" >"$tmp" && mv "$tmp" "$LAST_FILE"
  fi

  local plan todo
  plan=$(restore_plan "$(live_windows)")
  todo=$(jq -c --arg only "$only" '.[] | select($only == "" or .ws == ($only | tonumber)) | .ws as $ws | .windows[] | select(.open | not) | . + {ws: $ws}' <<<"$plan")
  if [[ -z $todo ]]; then
    local msg="Everything from the last session is already open."
    $notify_done && ! $login && notify "Nothing to restore" "$msg"
    $login || echo "$msg"
    return 0
  fi

  local w ws name opened=0 failed=0 workspaces=()
  while IFS= read -r w; do
    ws=$(jq -r .ws <<<"$w")
    name=$(jq -r .name <<<"$w")
    if $dry; then echo "workspace $ws: $name"; continue; fi
    if open_on_workspace "$ws" "$(jq -r .class <<<"$w")" "$(restore_command "$w")"; then
      opened=$((opened + 1))
      [[ " ${workspaces[*]} " == *" $ws "* ]] || workspaces+=("$ws")
      echo "✓ workspace $ws: $name"
    else
      failed=$((failed + 1))
      echo "✗ workspace $ws: $name (no window after ${RESTORE_TIMEOUT}s)"
    fi
  done <<<"$todo"
  $dry && return 0
  if $notify_done; then
    local body list
    list=$(IFS=,; echo "${workspaces[*]}")
    body="$opened window$( ((opened == 1)) || echo s) on workspace$( ((${#workspaces[@]} == 1)) || echo s) ${list//,/, }"
    ((failed)) && body+=", $failed did not open"
    notify "Windows restored" "$body"
  fi
  ((failed == 0))
}

LINKS=(
  "$HOME/.config/omarchy/plugins/mehiel.omaprojectspace|$REPO"
  "$HOME/.local/bin/omaprojectspace|$REPO/bin/omaprojectspace"
  "$HOME/.local/bin/uwsm-app|$REPO/shim/uwsm-app"
  "$HOME/.config/hypr/omaprojectspace.lua|$REPO/hypr/omaprojectspace.lua"
)

cmd_install() {
  local pair link target
  for pair in "${LINKS[@]}"; do
    link=${pair%%|*} target=${pair#*|}
    # `omarchy plugin add` clones the repo straight into the plugin folder.
    if [[ -e $link && $(readlink -f "$link") == "$(readlink -f "$target")" ]]; then
      echo "ok    $(contract_home "$link")"
      continue
    fi
    if [[ -e $link && ! -L $link ]]; then
      echo "skip  $link (a real file is in the way)"
      continue
    fi
    mkdir -p "$(dirname "$link")"
    ln -sfn "$target" "$link"
    echo "link  $(contract_home "$link") → $(contract_home "$target")"
  done
  local hyprland=$HOME/.config/hypr/hyprland.lua
  if [[ -f $hyprland ]] && ! grep -q 'require("hypr.omaprojectspace")' "$hyprland"; then
    printf '\n-- Projectspaces: workspace ↔ team folder binds (mehiel.omaprojectspace).\nrequire("hypr.omaprojectspace")\n' >>"$hyprland"
    echo "added require(\"hypr.omaprojectspace\") to $(contract_home "$hyprland")"
  fi
  omarchy-shell -q shell rescanPlugins || true
  hyprctl reload >/dev/null 2>&1 || true
  echo "done. Put the widget on the bar with: omarchy bar put mehiel.omaprojectspace"
}

cmd_uninstall() {
  local pair link target
  for pair in "${LINKS[@]}"; do
    link=${pair%%|*} target=${pair#*|}
    if [[ -L $link && $(readlink "$link") == "$target" ]]; then
      rm "$link"
      echo "unlink $(contract_home "$link")"
    fi
  done
  local hyprland=$HOME/.config/hypr/hyprland.lua
  if [[ -f $hyprland ]] && grep -q 'require("hypr.omaprojectspace")' "$hyprland"; then
    sed -i '/^-- Projectspaces: workspace ↔ team folder binds/d; /^require("hypr.omaprojectspace")$/d' "$hyprland"
    echo "removed require(\"hypr.omaprojectspace\") from $(contract_home "$hyprland")"
  fi
  hyprctl reload >/dev/null 2>&1 || true
}

# This session's copy of a process: with a nested session (the demo) or a
# second login running, the first match by name may belong to another one.
session_pid() {
  local pid sig=${HYPRLAND_INSTANCE_SIGNATURE:-}
  for pid in $(pgrep -x "$1"); do
    if [[ -z $sig ]] || { tr '\0' '\n' <"/proc/$pid/environ"; } 2>/dev/null | grep -qx "HYPRLAND_INSTANCE_SIGNATURE=$sig"; then
      echo "$pid"
      return
    fi
  done
  # Hyprland's own env predates its signature; match it by instance instead.
  [[ $1 == Hyprland ]] && hyprctl instances -j 2>/dev/null | jq -r --arg s "$sig" '.[] | select(.instance == $s) | .pid' | head -1
  return 0
}

cmd_doctor() {
  local bad=0
  local green="" yellow="" reset=""
  if [[ -t 1 ]]; then green=$'\e[32m' yellow=$'\e[33m' reset=$'\e[0m'; fi
  ok() { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
  warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$*"; bad=1; }

  echo "Install"
  local pair link target
  for pair in "${LINKS[@]}"; do
    link=${pair%%|*} target=${pair#*|}
    if [[ -e $link && $(readlink -f "$link") == "$(readlink -f "$target")" ]]; then ok "$(contract_home "$link")"
    else warn "$(contract_home "$link") is not linked (run: omaprojectspace install)"; fi
  done

  echo "Session"
  local proc pid path resolved
  for proc in Hyprland quickshell; do
    pid=$(session_pid "$proc")
    if [[ -z $pid ]]; then warn "$proc is not running"; continue; fi
    path=$(tr '\0' '\n' <"/proc/$pid/environ" | sed -n 's/^PATH=//p')
    resolved=$(PATH=$path command -v uwsm-app || true)
    if [[ $(readlink -f "$resolved") == "$(readlink -f "$REPO/shim/uwsm-app")" ]]; then ok "$proc launches through the shim"
    else warn "$proc resolves uwsm-app to $resolved, not the shim"; fi
    # The shell launches apps through `bash -lc`, which rebuilds PATH from the
    # login profile; the shim has to win there too.
    if [[ $proc == quickshell ]]; then
      resolved=$(env -i HOME="$HOME" USER="${USER:-}" PATH="$path" bash -lc 'command -v uwsm-app' 2>/dev/null || true)
      if [[ $(readlink -f "$resolved") == "$(readlink -f "$REPO/shim/uwsm-app")" ]]; then ok "quickshell's login-shell launches go through the shim"
      else warn "a login shell resolves uwsm-app to $resolved; put ~/.local/bin before /usr/bin in your profile"; fi
    fi
    if tr '\0' '\n' <"/proc/$pid/environ" | grep -q '^PROJECTSPACE='; then
      warn "$proc carries a PROJECTSPACE env (restarted from a projectspace terminal?); restart it from a plain one"
    fi
  done

  echo "Windows"
  local saved
  saved=$(jq -r --arg i "$(instance_id)" 'select(.instance == $i) | .saved' "$SESSION_FILE" 2>/dev/null || true)
  if [[ -n $saved ]] && (($(date +%s) - saved < 180)); then ok "saved every minute ($(contract_home "$SESSION_FILE"))"
  else warn "windows are not being saved: reload Hyprland (hyprctl reload) after install"; fi
  if [[ -s $LAST_FILE ]]; then ok "last session: $(windows_count "$LAST_FILE") windows to restore from"; fi

  echo "Projectspaces"
  local data
  data=$(list_json)
  # \x1f, not a tab: read collapses runs of whitespace separators, and an
  # empty error field would shift every column after it.
  while IFS=$'\x1f' read -r name display ok error ws; do
    if [[ $ok == true ]]; then ok "$name  $display${ws:+  (ws $ws)}"
    else warn "$name  $display: $error"; fi
  done < <(jq -r '.projectspaces[] | [.name, .display, (.ok|tostring), .error, (.workspaces | map(tostring) | join(","))] | join("\u001f")' <<<"$data")
  while IFS=$'\x1f' read -r ws home; do
    warn "workspace $ws is attached to $home, which is not a projectspace any more"
  done < <(jq -r '.attachments | to_entries[] | select(.value.missing) | [.key, .value.home] | join("\u001f")' <<<"$data")

  return $bad
}

main() {
  local cmd=${1:-help}
  (($#)) && shift
  case $cmd in
  list | ls) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
  env) cmd_env "$@" ;;
  exec) cmd_exec "$@" ;;
  attach) cmd_attach "$@" ;;
  detach) cmd_detach "$@" ;;
  launch) cmd_launch "$@" ;;
  browser) cmd_browser "$@" ;;
  save) cmd_save "$@" ;;
  windows) cmd_windows "$@" ;;
  restore) cmd_restore "$@" ;;
  install) cmd_install "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  doctor) cmd_doctor "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
  esac
}

main "$@"
